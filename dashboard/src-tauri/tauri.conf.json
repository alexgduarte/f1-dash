{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "f1-dash",
  "version": "../package.json",
  "identifier": "io.github.alexgduarte.f1dash",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "f1-dash",
        "url": "dashboard/",
        "width": 1440,
        "height": 900,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.multiviewer.app https://nominatim.openstreetmap.org https://api.rainviewer.com https://*.rainviewer.com https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' https://livetiming.formula1.com",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Sports",
    "shortDescription": "Real-time motorsport timing",
    "longDescription": "Live timing, tyre sets, track map, race control and weather radar for Formula 1, Formula 2, Formula 3, F1 Academy and the World Endurance Championship. Connects to the timing feeds directly, no account or server needed.",
    "homepage": "https://github.com/alexgduarte/f1-dash",
    "license": "AGPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
